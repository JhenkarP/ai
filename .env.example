# Server-side Places API key (Google Places search in the mobile app)
GOOGLE_MAPS_API_KEY=

# Server-side Routes API key (Google walking directions)
GOOGLE_ROUTES_API_KEY=

# Native map display keys; restrict these to the app's Android/iOS identity and Maps SDK.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# Optional cloud surroundings analysis. Server only; never bundle this in the phone app.
GEMINI_API_KEY=
SAFESTRIDE_VISION_MODEL=gemini-3.8-flash
